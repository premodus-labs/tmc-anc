      "name": "5. Deactivation and logout",
      "item": [
        {
          "name": "Deactivate the new user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"inactive\", () => pm.expect(pm.response.json().data.is_active).to.be.false);"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
