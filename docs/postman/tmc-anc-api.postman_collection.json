                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"has the clinic roles\", () => pm.expect(pm.response.json().data.map(r => r.code)).to.include.members([\"admin\", \"receptionist\", \"nurse_midwife\", \"clinician\"]));"
                ]
