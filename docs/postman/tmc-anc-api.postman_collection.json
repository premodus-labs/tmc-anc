                  "key": "has_login",
                  "value": "0"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Create user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"new_username\", \"nurse_\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const user = pm.response.json().data;",
                  "pm.collectionVariables.set(\"user_id\", user.id);",
                  "pm.test(\"starts as receptionist\", () => pm.expect(user.roles.map(r => r.code)).to.eql([\"receptionist\"]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"staff_id\": \"{{staff_id}}\",\n  \"username\": \"{{new_username}}\",\n  \"password\": \"Welcome123\",\n  \"roles\": [\n    \"receptionist\"\n  ]\n}"
            }
          }
        },
        {
          "name": "List users (search)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
