              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const staff = pm.response.json().data;",
                  "pm.test(\"at least one staff member is free (re-seed if not)\", () => pm.expect(staff.length).to.be.above(0));",
                  "pm.collectionVariables.set(\"staff_id\", staff[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
